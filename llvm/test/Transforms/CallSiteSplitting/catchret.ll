; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --scrub-attributes --version 6
; RUN: opt -S -verify-each -passes=callsite-splitting < %s | FileCheck %s
;
; A call site whose predecessors end in catchret must not be split: the cloned
; calls would be placed inside the catch funclets without a "funclet" operand
; bundle, and WinEHPrepare would then replace them with unreachable.

target triple = "x86_64-pc-windows-msvc"

declare void @thrower()
declare i32 @__CxxFrameHandler3(...)

define void @use(i32 %x) {
; CHECK-LABEL: define void @use(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    call void @thrower()
; CHECK-NEXT:    ret void
;
  call void @thrower()
  ret void
}


define void @f() personality ptr @__CxxFrameHandler3 {
; CHECK-LABEL: define void @f() personality ptr @__CxxFrameHandler3 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    invoke void @thrower()
; CHECK-NEXT:            to label %[[UNR:.*]] unwind label %[[CS:.*]]
; CHECK:       [[CS]]:
; CHECK-NEXT:    [[SW:%.*]] = catchswitch within none [label %[[C1:.*]], label %[[C2:.*]]] unwind to caller
; CHECK:       [[C1]]:
; CHECK-NEXT:    [[P1:%.*]] = catchpad within [[SW]] [ptr null, i32 64, ptr null]
; CHECK-NEXT:    catchret from [[P1]] to label %[[TAIL:.*]]
; CHECK:       [[C2]]:
; CHECK-NEXT:    [[P2:%.*]] = catchpad within [[SW]] [ptr null, i32 64, ptr null]
; CHECK-NEXT:    catchret from [[P2]] to label %[[TAIL]]
; CHECK:       [[TAIL]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 1, %[[C1]] ], [ 2, %[[C2]] ]
; CHECK-NEXT:    call void @use(i32 [[V]])
; CHECK-NEXT:    ret void
; CHECK:       [[UNR]]:
; CHECK-NEXT:    unreachable
;
entry:
  invoke void @thrower() to label %unr unwind label %cs
cs:
  %sw = catchswitch within none [label %c1, label %c2] unwind to caller
c1:
  %p1 = catchpad within %sw [ptr null, i32 64, ptr null]
  catchret from %p1 to label %tail
c2:
  %p2 = catchpad within %sw [ptr null, i32 64, ptr null]
  catchret from %p2 to label %tail
tail:
  %v = phi i32 [ 1, %c1 ], [ 2, %c2 ]
  call void @use(i32 %v)
  ret void
unr:
  unreachable
}

; Either predecessor can be a catchret. Keep the two block orders to exercise
; both positions in the predecessor list.
define void @catchret_first() personality ptr @__CxxFrameHandler3 {
; CHECK-LABEL: define void @catchret_first() personality ptr @__CxxFrameHandler3 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    invoke void @thrower()
; CHECK-NEXT:            to label %[[NORMAL:.*]] unwind label %[[DISPATCH:.*]]
; CHECK:       [[NORMAL]]:
; CHECK-NEXT:    br label %[[TAIL:.*]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[SWITCH:%.*]] = catchswitch within none [label %[[HANDLER:.*]]] unwind to caller
; CHECK:       [[HANDLER]]:
; CHECK-NEXT:    [[PAD:%.*]] = catchpad within [[SWITCH]] [ptr null, i32 64, ptr null]
; CHECK-NEXT:    catchret from [[PAD]] to label %[[TAIL]]
; CHECK:       [[TAIL]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 1, %[[NORMAL]] ], [ 2, %[[HANDLER]] ]
; CHECK-NEXT:    call void @use(i32 [[V]])
; CHECK-NEXT:    ret void
;
entry:
  invoke void @thrower() to label %normal unwind label %dispatch
normal:
  br label %tail
dispatch:
  %switch = catchswitch within none [label %handler] unwind to caller
handler:
  %pad = catchpad within %switch [ptr null, i32 64, ptr null]
  catchret from %pad to label %tail
tail:
  %v = phi i32 [ 1, %normal ], [ 2, %handler ]
  call void @use(i32 %v)
  ret void
}

define void @catchret_second() personality ptr @__CxxFrameHandler3 {
; CHECK-LABEL: define void @catchret_second() personality ptr @__CxxFrameHandler3 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    invoke void @thrower()
; CHECK-NEXT:            to label %[[NORMAL:.*]] unwind label %[[DISPATCH:.*]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[SWITCH:%.*]] = catchswitch within none [label %[[HANDLER:.*]]] unwind to caller
; CHECK:       [[HANDLER]]:
; CHECK-NEXT:    [[PAD:%.*]] = catchpad within [[SWITCH]] [ptr null, i32 64, ptr null]
; CHECK-NEXT:    catchret from [[PAD]] to label %[[TAIL:.*]]
; CHECK:       [[NORMAL]]:
; CHECK-NEXT:    br label %[[TAIL]]
; CHECK:       [[TAIL]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 1, %[[NORMAL]] ], [ 2, %[[HANDLER]] ]
; CHECK-NEXT:    call void @use(i32 [[V]])
; CHECK-NEXT:    ret void
;
entry:
  invoke void @thrower() to label %normal unwind label %dispatch
dispatch:
  %switch = catchswitch within none [label %handler] unwind to caller
handler:
  %pad = catchpad within %switch [ptr null, i32 64, ptr null]
  catchret from %pad to label %tail
normal:
  br label %tail
tail:
  %v = phi i32 [ 1, %normal ], [ 2, %handler ]
  call void @use(i32 %v)
  ret void
}
