; With /EHa, C++ invokes also protect hardware faults. A plain call in this
; module remains promotable. Uncomment the flag only for the ASYNC run.
; MODULE-FLAG: !llvm.module.flags = !{!0}
; MODULE-FLAG: !0 = !{i32 1, !"eh-asynch", i32 1}
