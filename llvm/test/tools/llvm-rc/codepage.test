; openrt RC-PRAGMA-CODEPAGE: "#pragma code_page(N)" switches the code page for the
; text after it, as rc.exe does (observed: the same .res from rc.exe).
; RUN: llvm-rc -no-preprocess /FO %t.pragma.res -- %p/Inputs/utf8-pragma.rc
; RUN: llvm-readobj %t.pragma.res | FileCheck %s --check-prefix=PRAGMA
; PRAGMA:      0000: 00000300 A9002000 78000400 C200A900
; PRAGMA-NEXT: 0010: 20007900 00000000 00000000 00000000

; Another code page in the pragma (Visual Studio writes code_page(1251), (932))
; takes plain ASCII, as rc.exe and llvm-rc before, and non-ASCII text through
; the built-in code page tables, as rc.exe (also with /C 1252 before it).
; RUN: llvm-rc -no-preprocess /FO %t.p1251.res -- %p/Inputs/pragma-1251-ascii.rc
; RUN: llvm-readobj %t.p1251.res | FileCheck %s --check-prefix=P1251
; P1251: Data size: 52
; RUN: llvm-windres --no-preprocess %p/Inputs/pragma-1251-ascii.rc %t.p1251w.res
; RUN: llvm-rc -no-preprocess /FO %t.p1251n.res -- %p/Inputs/pragma-1251-nonascii.rc
; RUN: llvm-readobj %t.p1251n.res | FileCheck %s --check-prefix=P1251N
; RUN: llvm-rc -no-preprocess /C 1252 /FO %t.p1251c.res -- %p/Inputs/pragma-1251-nonascii.rc
; RUN: llvm-readobj %t.p1251c.res | FileCheck %s --check-prefix=P1251N
; P1251N: 0000: 00000100 39040000 00000000 00000000

; Under another pragma code page a narrow user-resource string is read in that
; page and written in 1252 (rc.exe: "\xC6\xE8" under 1251 in RCDATA is 3F 3F),
; and an escaped byte is taken as in 1252 (STRINGTABLE "\xC6a" is U+00C6, RCDATA
; "\xC6" is C6), the same .res data as rc.exe.
; RUN: llvm-rc -no-preprocess /FO %t.ud.res -- %p/Inputs/ud1251.rc
; RUN: llvm-readobj %t.ud.res | FileCheck %s --check-prefix=UD1251
; UD1251: Data:: (3F 3F)
; RUN: llvm-rc -no-preprocess /FO %t.esc.res -- %p/Inputs/esc1251.rc
; RUN: llvm-readobj %t.esc.res | FileCheck %s --check-prefix=ESC1251
; ESC1251: 0000: 00000200 C6006100 00000000 00000000
; RUN: llvm-rc -no-preprocess /FO %t.escud.res -- %p/Inputs/escud1251.rc
; RUN: llvm-readobj %t.escud.res | FileCheck %s --check-prefix=ESCUD1251
; ESCUD1251: Data:: (C6)

; A narrow user-resource string is written in 1252 with best fit, '?' where
; there is none (rc.exe: under 1250 "\xA5\xB3" (U+0104 U+0142) is 41 6C; under
; 1253 "\xC1\xE1" (U+0391 U+03B1) is 3F 61), and an escaped byte there is
; written as it is (rc.exe: under 1251 "\351\x80" is E9 80).
; RUN: llvm-rc -no-preprocess /FO %t.bf1250.res -- %p/Inputs/bf1250.rc
; RUN: llvm-readobj %t.bf1250.res | FileCheck %s --check-prefix=BF1250
; BF1250: Data:: (41 6C)
; RUN: llvm-rc -no-preprocess /FO %t.g1253.res -- %p/Inputs/g1253.rc
; RUN: llvm-readobj %t.g1253.res | FileCheck %s --check-prefix=G1253
; G1253: Data:: (3F 61)
; RUN: llvm-rc -no-preprocess /FO %t.octud.res -- %p/Inputs/octud1251.rc
; RUN: llvm-readobj %t.octud.res | FileCheck %s --check-prefix=OCTUD
; OCTUD: Data:: (E9 80)
