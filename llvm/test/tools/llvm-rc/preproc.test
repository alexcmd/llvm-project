; RUN: env INCLUDE=%p llvm-rc -### -i%p "-DFOO1=\"foo bar\"" -UFOO2 -D FOO3 -- %p/Inputs/empty.rc | FileCheck %s

; CHECK: {{^}} "clang" "--driver-mode=gcc" "-target" "{{.*}}-pc-windows-msvc-coff" "-E" "-xc" "-DRC_INVOKED" "-I" "{{.*}}" "-D" "FOO1=\"foo bar\"" "-U" "FOO2" "-D" "FOO3" "{{.*}}empty.rc" "-o" "{{.*}}preproc-{{.*}}.rc"{{$}}

; openrt LLVM-RC-NO-VC-AUTODETECT: with %INCLUDE% unset or empty, or with /X,
; rc.exe never looks for a Visual Studio / Windows SDK install: llvm-rc passes
; -nostdlibinc so the clang MSVC driver does not autodetect one either.
; RUN: env -u INCLUDE llvm-rc -### -- %p/Inputs/empty.rc | FileCheck %s --check-prefix=NOVC
; RUN: env INCLUDE= llvm-rc -### -- %p/Inputs/empty.rc | FileCheck %s --check-prefix=NOVC
; RUN: env INCLUDE=%p llvm-rc -### /X -- %p/Inputs/empty.rc | FileCheck %s --check-prefix=NOVC
; RUN: env INCLUDE=%p llvm-rc -### -- %p/Inputs/empty.rc | FileCheck %s --check-prefix=INC
; NOVC: {{^}} "clang" "--driver-mode=gcc" "-target" "{{.*}}-pc-windows-msvc-coff" "-E" "-xc" "-DRC_INVOKED" "-nostdlibinc" "{{.*}}empty.rc"
; INC-NOT: -nostdlibinc
; INC: "-DRC_INVOKED" "{{.*}}empty.rc"
