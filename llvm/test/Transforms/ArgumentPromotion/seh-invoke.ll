; SYNC-NEXT:            to label %[[CONT:.*]] unwind label %[[DISPATCH:.*]]
; SYNC:       [[CONT]]:
; SYNC-NEXT:    ret i32 [[R]]
; SYNC:       [[DISPATCH]]:
; SYNC-NEXT:    [[CS:%.*]] = catchswitch within none [label %[[HANDLER:.*]]] unwind to caller
; SYNC:       [[HANDLER]]:
; SYNC-NEXT:    [[CP:%.*]] = catchpad within [[CS]] [ptr null, i32 64, ptr null]
; SYNC-NEXT:    catchret from [[CP]] to label %[[EXCEPT:.*]]
; SYNC:       [[EXCEPT]]:
; SYNC-NEXT:    ret i32 -1
