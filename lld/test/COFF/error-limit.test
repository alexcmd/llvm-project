RUN: not lld-link /nodefaultliba /nodefaultlibb /nodefaultlibc /nodefaultlibd /nodefaultlibe /nodefaultlibf /nodefaultlibg /nodefaultlibh /nodefaultlibi /nodefaultlibj /nodefaultlibk /nodefaultlibl /nodefaultlibm /nodefaultlibn /nodefaultlibo /nodefaultlibp /nodefaultlibq /nodefaultlibr /nodefaultlibs /nodefaultlibt \
RUN:   /nodefaultlibu /nodefaultlibv 2>&1 | FileCheck -check-prefix=DEFAULT %s

