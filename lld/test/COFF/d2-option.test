# openrt UE-D2-EXTWARN: link.exe accepts /d2:<anything> (handed to the LTCG
# code generator) silently; UBT passes /d2:-ExtendedWarningInfo. An empty
# value is LNK1146.
RUN: yaml2obj %p/Inputs/ret42.yaml -o %t.obj
RUN: lld-link /out:%t.exe /entry:main %t.obj /d2:-ExtendedWarningInfo /d2:xyzzy 2>&1 | count 0
RUN: not lld-link /out:%t.exe /entry:main %t.obj /d2: 2>&1 | FileCheck %s
CHECK: LNK1146
