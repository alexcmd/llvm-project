; ASYNC-LABEL: define i32 @cxx_caller(
; ASYNC-SAME: ptr [[P:%.*]]) personality ptr @__CxxFrameHandler3 {
; ASYNC-NEXT:  [[ENTRY:.*:]]
; ASYNC-NEXT:    [[R:%.*]] = invoke i32 @cxx_callee(ptr [[P]])
; ASYNC-NEXT:            to label %[[CONT:.*]] unwind label %[[DISPATCH:.*]]
; ASYNC:       [[CONT]]:
; ASYNC-NEXT:    ret i32 [[R]]
; ASYNC:       [[DISPATCH]]:
; ASYNC-NEXT:    [[CS:%.*]] = catchswitch within none [label %[[HANDLER:.*]]] unwind to caller
; ASYNC:       [[HANDLER]]:
; ASYNC-NEXT:    [[CP:%.*]] = catchpad within [[CS]] [ptr null, i32 64, ptr null]
; ASYNC-NEXT:    catchret from [[CP]] to label %[[EXCEPT:.*]]
; ASYNC:       [[EXCEPT]]:
; ASYNC-NEXT:    ret i32 -1
;
entry:
  %r = invoke i32 @cxx_callee(ptr %p)
  to label %cont unwind label %dispatch

cont:
  ret i32 %r

dispatch:
  %cs = catchswitch within none [label %handler] unwind to caller

handler:
