; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --scrub-attributes --version 6
; RUN: opt -S -verify-each -passes=argpromotion < %s | FileCheck %s \
; RUN: --check-prefixes=CHECK,SYNC
; RUN: opt -S -verify-each -mtriple=i686-pc-windows-msvc -passes=argpromotion \
; RUN: < %s | FileCheck %s --check-prefixes=CHECK,SYNC
; RUN: sed "s/^; MODULE-FLAG: //" %s | opt -S -verify-each \
; RUN: -passes=argpromotion | FileCheck %s --check-prefixes=CHECK,ASYNC

; Argument promotion moves the callee's loads into the caller in front of the
; call. If the call site is an invoke under an asynchronous (SEH) personality,
; a fault in such a load must be caught by the handler of the invoke. Hoisted
; out of the callee, it would land outside the invoke's EH range. Such loads
; require a dereferenceability proof before promotion.

target triple = "x86_64-pc-windows-msvc"

; SEH __try/__except around a call: __C_specific_handler.

define internal i32 @seh_callee(ptr %p) {
; CHECK-LABEL: define internal i32 @seh_callee(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %v = load i32, ptr %p
  ret i32 %v
}

define i32 @seh_caller(ptr %p) personality ptr @__C_specific_handler {
; CHECK-LABEL: define i32 @seh_caller(
; CHECK-SAME: ptr [[P:%.*]]) personality ptr @__C_specific_handler {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[R:%.*]] = invoke i32 @seh_callee(ptr [[P]])
; CHECK-NEXT:            to label %[[CONT:.*]] unwind label %[[DISPATCH:.*]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    ret i32 [[R]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[CS:%.*]] = catchswitch within none [label %[[HANDLER:.*]]] unwind to caller
; CHECK:       [[HANDLER]]:
; CHECK-NEXT:    [[CP:%.*]] = catchpad within [[CS]] [ptr null]
; CHECK-NEXT:    catchret from [[CP]] to label %[[EXCEPT:.*]]
; CHECK:       [[EXCEPT]]:
; CHECK-NEXT:    ret i32 -1
;
entry:
  %r = invoke i32 @seh_callee(ptr %p)
  to label %cont unwind label %dispatch

cont:
  ret i32 %r

dispatch:
  %cs = catchswitch within none [label %handler] unwind to caller

handler:
  %cp = catchpad within %cs [ptr null]
  catchret from %cp to label %except

except:
  ret i32 -1
}

; C++ EH (synchronous personality): a fault is not an exception, promotion is
; still done.

define internal i32 @cxx_callee(ptr %p) {
; SYNC-LABEL: define internal i32 @cxx_callee(
; SYNC-SAME: i32 [[P_0_VAL:%.*]]) {
; SYNC-NEXT:    ret i32 [[P_0_VAL]]
;
; ASYNC-LABEL: define internal i32 @cxx_callee(
; ASYNC-SAME: ptr [[P:%.*]]) {
; ASYNC-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; ASYNC-NEXT:    ret i32 [[V]]
;
  %v = load i32, ptr %p
  ret i32 %v
}

