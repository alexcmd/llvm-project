; CHECK:       [[CONT]]:
; CHECK-NEXT:    ret i32 0
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[CS:%.*]] = catchswitch within none [label %[[HANDLER:.*]]] unwind to caller
; CHECK:       [[HANDLER]]:
; CHECK-NEXT:    [[CP:%.*]] = catchpad within [[CS]] [ptr null]
; CHECK-NEXT:    [[P_VAL:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[R:%.*]] = call i32 @funclet_callee(i32 [[P_VAL]]) [ "funclet"(token [[CP]]) ]
; CHECK-NEXT:    catchret from [[CP]] to label %[[EXCEPT:.*]]
; CHECK:       [[EXCEPT]]:
