# RUN: not llvm-ml %basename_t.blah.asm /nologo /Fo /dev/null 2>&1 | FileCheck -DMSG=%errc_ENOENT --check-prefix=ENOENT %s
# RUN: not llvm-ml /Ta /nnlogo /Fo /dev/null 2>&1 | FileCheck -DMSG=%errc_ENOENT --check-prefix=ENOENT-TA %s
# ML-UNKNOWN-OPTION: a '/name' that is not a file is an unknown option
# (warning A4018, as ML64.EXE), not a missing file: ml64_unknown_option.asm.

# ENOENT-NOT: nologo
# ENOENT: {{.*}}.blah.asm: [[MSG]]
# ENOENT-TA: /nnlogo: [[MSG]]
